<idea-plugin>
    <name>Resin-Pura</name>
    <id>com.dingdangmaoup.resin.pura</id>

    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.javaee</depends>
    <depends>com.intellij.javaee.app.servers.integration</depends>

    <description>
        基于 JetBrains 已停止维护的 Resin 开源插件（intellij-obsolete-plugins/resin）进行升级迁移，
        持续适配 IntelliJ IDEA 2024.2–2026.2（Build 242–262.*）。
    </description>
    <vendor>dingdangmaoup</vendor>
    <category>Deployment</category>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.dingdangmaoup.resin.pura.ResinConfigurationType"/>
        <configurationProducer implementation="com.dingdangmaoup.resin.pura.ResinConfigurationProducer"/>
        <javaee.app.servers.integration.appServerIntegration implementation="com.dingdangmaoup.resin.pura.ResinManager"/>
    </extensions>
</idea-plugin>
